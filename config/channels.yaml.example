  #   type: discord
  #   app_id: ${DISCORD_BOT_TOKEN}            # Bot Token
  #   app_secret: ${DISCORD_APPLICATION_ID}   # Application ID（频道 @Bot 匹配）
  #   agent: ops-agent
  #   enabled: true
